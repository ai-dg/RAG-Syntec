# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local configuration
.env
.env.local
.env.*.local

# Editor and tooling configuration (local only)
.vscode/
.idea/
*.swp

# Vector stores and indexes
chroma_db/
qdrant_storage/

# Corpus acquisition: raw HTML archive (38MB, entirely regenerable via
# scripts/fetch_kali_id.py + fetch_corpus.py, never read by the app
# directly). The corpus itself now lives in data/converted/ and IS
# tracked (3.1MB, what the app actually indexes) — see design/corpus.md.
data/raw/
tools/


# Trained models. Only the manifest describing them is tracked.
# Note: the directory itself must not be excluded, or the negation below
# would never be evaluated.
models/*
!models/manifest.json

# Model caches (Docling, sentence-transformers, HuggingFace)
.cache/
*.onnx

# OS
.DS_Store
Thumbs.db
