# Choose the LLM provider: "openai" or "ollama"
LLM_PROVIDER=ollama

## API-key mode (LLM_PROVIDER=openai)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

## Local mode (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_LOCAL=qwen3-embedding:8b
CHAT_MODEL_LOCAL=gemma4:latest

# Shared
DOCS_DIR=data/converted/
CHROMA_DIR=chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=3
SYSTEM_PROMPT=Tu es un assistant qui répond aux questions sur la convention collective Syntec (Bureaux d'études techniques, IDCC 1486) en t'appuyant uniquement sur les extraits fournis. Réponds en français, de façon concise, sans rien inventer.

# Guardrail threshold. This is a DISTANCE (lower = more relevant), not a
# similarity score — see design/guardrail.md and scripts/inspect_metric.py.
# Calibrated per embedding model; recalibrate whenever the model or corpus changes.
RELEVANCE_THRESHOLD=0.74

# Legal text versions: superseded articles are excluded from search unless true
# (design/versioning.md).
INCLUDE_SUPERSEDED=false

# Chunking: "fixed" (500-character pieces, the measured default) or "article"
# (split along the agreement's articles; design/chunking.md). Changing it, the
# chunk size or the embedding model rebuilds the index at the next start.
CHUNKING=fixed
REINDEX_ON_STARTUP=false

# Answer-or-refuse decision: "threshold" (distance, default) or "classifier"
# (logistic regression in models/abstention.json; design/abstention.md).
GUARDRAIL_MODE=threshold
ABSTENTION_MODEL_PATH=models/abstention.json

# Extra guardrail layers (design/guardrail.md): injection phrasing before
# retrieval, and lexical support of the answer by its context after generation.
INPUT_GUARD=true
OUTPUT_GUARD=true
GROUNDEDNESS_THRESHOLD=0.5

# Ask the model to cite numbered passages; invented citations are removed.
CITE_SOURCES=true

# Cross-encoder reranking: measured and rejected (design/reranking.md); needs
# `uv sync --extra rerank`.
RERANK_ENABLED=false
RERANK_CANDIDATES=20
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
